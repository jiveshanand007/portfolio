# Postgres (Neon serverless)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Chat model: any OpenAI-compatible provider, or Anthropic. Examples:
#   Gemini     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-3.5-flash-lite
#   Groq       LLM_BASE_URL=https://api.groq.com/openai/v1                         LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter LLM_BASE_URL=https://openrouter.ai/api/v1                            LLM_MODEL=<provider/model>
#   OpenAI     LLM_BASE_URL=https://api.openai.com/v1                               LLM_MODEL=<model>
#   Anthropic  LLM_PROVIDER=anthropic (no base URL; Sonnet + Haiku by default)
LLM_PROVIDER=openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Optional: a cheaper model for query rewriting (defaults to LLM_MODEL)
# LLM_FAST_MODEL=<cheaper model>
# Optional: USD per 1M tokens, counted against DAILY_CAP_CENTS (0 on a free tier)
# LLM_PRICE_IN_PER_1M=0
# LLM_PRICE_OUT_PER_1M=0
# Optional: give up on a slow provider after this many seconds (default 60)
# LLM_TIMEOUT_SECONDS=60
# Optional: for thinking models, limit hidden reasoning (e.g. none, low) so it does not eat max tokens
# LLM_REASONING_EFFORT=

# Voyage AI — embeddings + rerank
VOYAGE_API_KEY=pa-...

# Bearer token for /api/admin/* endpoints
INGEST_TOKEN=replace-with-random-32-chars

# Rotated daily; used to salt IP hashes for rate limiting
DAILY_SALT=replace-with-random-32-chars

# Daily INR spend cap in centi-paise (₹200 = 20000)
DAILY_CAP_CENTS=20000

# Rate limit
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=3600

# Source A indexing
GITHUB_USERNAME=jiveshanand007
GITHUB_TOKEN= # optional, raises rate limit

# Contact form (app/api/contact): https://resend.com -> API Keys. Without it the form says "not set up yet".
RESEND_API_KEY=
# Optional: where messages go (defaults to the email in content/site.json) and the sender address.
# CONTACT_TO=
# CONTACT_FROM="Portfolio contact <onboarding@resend.dev>"
